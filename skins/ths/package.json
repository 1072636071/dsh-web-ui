{
  "name": "@deepseek-ai/dsh-client-ui-skin-ths",
  "description": "Hot-pluggable Tonghuashun-style stock-trading skin for the dsh web GUI: red brand chrome, quote status bar, data-terminal surfaces",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dshClient": {
    "inject": [
      "@deepseek-ai/dsh-client-connection"
    ],
    "platform": "web"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown",
    "prepare": "tsdown",
    "watch": "tsdown --watch",
    "test": "vitest run"
  },
  "license": "BSD-3-Clause",
  "peerDependencies": {
    "cordis": "^4.0.0-rc.7",
    "@deepseek-ai/dsh-client-connection": "^0.0.1"
  },
  "devDependencies": {
    "cordis": "^4.0.0-rc.7",
    "jsdom": "29.1.1",
    "lightningcss": "^1.32.0",
    "tsdown": "^0.22.2",
    "vitest": "^4.1.8",
    "@deepseek-ai/dsh-client-connection": "workspace:^"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "skin.json",
    "preview",
    "README.md",
    "README.zh.md",
    "README.i18n.yaml"
  ]
}
